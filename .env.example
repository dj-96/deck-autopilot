# Copy this file to .env (in this folder or the folder above it) and fill in real values.
# The app needs at least ONE of the two keys below.

# Course key, routed through Portkey. Tried first.
PORTKEY_API_KEY=

# Personal OpenAI key. Used automatically if the Portkey key is missing or out of budget.
OPENAI_API_KEY=

# Optional: force one gateway instead of auto-fallback. Values: auto | portkey | openai
# LLM_GATEWAY=auto
